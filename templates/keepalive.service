# =============================================================================
# 模板：keepalive 守护服务（systemd 单元；脱敏模板）
#
# 【用途】
#   周期性对每个"认证会话出口"做轻量探活（ping），仅当数据面存活（丢包为 0）
#   时才继续发包，让免密 / 无感认证会话保持在线、避免掉线后重新认证；同时用
#   systemd 的 Restart 策略保证保活循环本身崩溃后自动拉起（自愈）。
#   相比"定时任务每 5 分钟跑一次"的简易做法，本单元改为常驻循环 + 崩溃自愈，
#   实现方式同已在用的 keepalive 逻辑：只探活不重拨、不重建会话。
#
# 【前置条件】
#   · 目标机为 systemd 发行版（主流的 Linux 服务器 / 虚拟机发行版均可）。
#   · 存在可执行的保活脚本 <保活脚本路径>（参考内容见文件末尾注释），它对
#     每个出口接口做 ping 探活并维持会话。
#   · ping 需要原始套接字：若 <运行用户> 无对应能力，需给 ping 设置 setcap，
#     或把 User / Group 两行留空（以 root 运行）——按你的安全策略取舍。
#   · 若还需守护代理进程（如 mihomo），参考文件末尾"方案 B"另建一个单元。
#   · 安装：cp 本文件为 /etc/systemd/system/<服务名>.service，替换占位符后
#     systemctl daemon-reload && systemctl enable --now <服务名>。
#
# 【占位符清单】
#   <服务描述>            单元描述（如"多出口会话保活守护"）
#   <运行用户>/<运行用户组> 运行保活脚本的系统用户与组（留空则 root 运行）
#   <保活脚本路径>        保活脚本绝对路径（对应文件末尾的参考脚本）
#   <保活间隔秒>          每轮探活的间隔（如 300）
#   <重启间隔秒>          保活循环异常退出后的重启等待（如 5）
#   <出口接口A>/<出口接口B> 保活脚本中要探测的出口接口（见末尾脚本示例）
#   <探活目标IP>          保活脚本中 ping 的目标（见末尾脚本示例）
#   <代理服务名>/<代理守护描述>/<mihomo可执行文件路径>/<mihomo配置目录>
#                         （仅"方案 B"用到）
#
# 【风险提示】
#   · 仅限自有设备 / 自有账号（或已获授权账号）实验；遵守所在网络的接入与
#     使用规定，留意账号并发会话上限与设备数限制。
#   · 保活只"维持已在线会话"，不构成多会话合法性的依据；请自行确认会话数量
#     符合接入政策。
#   · 探活频率不宜过高、包不宜过大，避免被上游视为异常流量。
#   · 本模板不含任何真实标识；占位符规范见 docs/00_脱敏与贡献规范.md。
# =============================================================================

[Unit]
Description=<服务描述>
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<运行用户>
Group=<运行用户组>
# 保活主循环：每 <保活间隔秒> 跑一次保活脚本；脚本失败（非零退出）即结束本
# 循环，交由 Restart=on-failure 自动重启 → 自愈
ExecStart=/bin/sh -c 'while :; do <保活脚本路径>; rc=$?; [ "$rc" -ne 0 ] && exit "$rc"; sleep <保活间隔秒>; done'
Restart=on-failure
RestartSec=<重启间隔秒>
# 若本单元同时承载代理进程，建议加大文件描述符上限
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target

# ---------------------------------------------------------------------------
# 参考保活脚本内容：保存为 <保活脚本路径> 并 chmod +x
# 逻辑沿用在用的 keepalive 方案——只碰数据面存活的接口，不做 DHCP、不做会话
# 重建，避免触发重新认证：
#
#   #!/bin/sh
#   # 对每个出口接口做轻量探活：仅当"丢包为 0"时才继续发包维持会话
#   # 注意：不要用 `ping ... | tail -1` 取结果 —— tail 取到的是 rtt 行，
#   #       不含 "packet loss" 字样，会误判为 100% 丢包；一律用 grep 匹配：
#   for i in <出口接口A> <出口接口B>; do
#       if ping -I "$i" -c1 -W2 -q <探活目标IP> 2>/dev/null |
#           grep -q '0% packet loss'; then
#           ping -I "$i" -c3 -W2 -q <探活目标IP> >/dev/null 2>&1
#       fi
#   done
#   exit 0
#
# 方案 B：若需同时守护代理进程（如 mihomo，参考既有 VM 部署），另建一个单元：
#
#   # /etc/systemd/system/<代理服务名>.service
#   [Unit]
#   Description=<代理守护描述>
#   After=network-online.target
#   Wants=network-online.target
#   [Service]
#   Type=simple
#   User=<运行用户>
#   Group=<运行用户组>
#   ExecStart=<mihomo可执行文件路径> -d <mihomo配置目录>
#   Restart=on-failure
#   RestartSec=<重启间隔秒>
#   LimitNOFILE=65535
#   [Install]
#   WantedBy=multi-user.target
# ---------------------------------------------------------------------------